# ── Ollama (LLM / Vision backend) ────────────────────────────────────────────
# URL of the running Ollama server (preferred key)
OLLAMA_HOST=http://localhost:11435

# Legacy alias for OLLAMA_HOST — leave blank to use OLLAMA_HOST above
OLLAMA_BASE_URL=

# Default text-generation model served by Ollama
OLLAMA_MODEL=llama3.2

# Multimodal / vision model served by Ollama
OLLAMA_VISION_MODEL=llava

# Path to the on-device body-composition Keras model (relative to project root)
MODEL_PATH=models/body_composition.keras

# ── Database ──────────────────────────────────────────────────────────────────
# Async-driver URL. Leave blank → falls back to sqlite+aiosqlite:///./koda.db
# Postgres example: postgresql+asyncpg://user:pass@host:5432/koda
DATABASE_URL=

# ── Redis / Celery ────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# Celery broker URL (defaults to REDIS_URL when blank)
CELERY_BROKER_URL=redis://localhost:6379/0

# Celery result backend URL (defaults to REDIS_URL on DB 1 when blank)
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ── Application ───────────────────────────────────────────────────────────────
ENVIRONMENT=local

# Enable verbose SQL logging and debug tracebacks (set to true in development)
DEBUG=false
